# Generated by clisage integration zsh. Source only in Zsh.
# Only an explicit Alt-G sends the current input line to the provider.
_clisage_zsh_widget() {
    emulate -L zsh
    local suggestion
    [[ -n ${BUFFER//[[:space:]]/} ]] || return 0
    zle -M 'Clisage: generating a command suggestion...'
    if suggestion=$(command clisage shell --command-only -- "$BUFFER" </dev/null); then
        if [[ -n $suggestion ]]; then
            BUFFER=$suggestion
            CURSOR=${#BUFFER}
            zle reset-prompt
        else
            zle -M 'Clisage: empty suggestion; original input kept.'
        fi
    else
        zle -M 'Clisage: request failed or cancelled; original input kept.'
    fi
    # Assigning BUFFER never accepts or executes the line.
    return 0
}
zle -N _clisage_zsh_widget
bindkey -M emacs '^[g' _clisage_zsh_widget
bindkey -M emacs '^[G' _clisage_zsh_widget
bindkey -M viins '^[g' _clisage_zsh_widget
bindkey -M viins '^[G' _clisage_zsh_widget
